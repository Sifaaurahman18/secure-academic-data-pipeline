# =====================================================================
# Contoh konfigurasi Secure Academic Data Pipeline
#
# Berkas ini HANYA memuat nama variabel dan penanda. Tidak boleh ada
# kata sandi, token, atau kunci asli di dalamnya.
#
# Cara pakai:
#   1. Salin berkas ini menjadi .env
#   2. Isi setiap penanda __GANTI_..._ dengan nilai laboratorium Anda
#   3. Jangan pernah mengumpulkan atau membagikan berkas .env
#
# Berkas .env sudah didaftarkan pada .gitignore. Skrip
# tools/periksa_aset_proyek.py akan menolak paket yang masih memuat
# berkas .env atau nilai rahasia yang sudah terisi.
# =====================================================================

# --- Koneksi basis data laboratorium ---------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure_academic_lab

# --- Identitas yang dipakai starter API ------------------------------
# Akun ini hanya boleh membaca view yang diizinkan.
DB_USER=app_service
DB_PASSWORD=__GANTI_PASSWORD_APP_SERVICE__

# --- Identitas yang dipakai pipeline ingest --------------------------
# Akun ini hanya boleh menulis ke tabel staging.
PIPELINE_DB_USER=operator_pipeline
PIPELINE_DB_PASSWORD=__GANTI_PASSWORD_OPERATOR__

# --- Rahasia aplikasi ------------------------------------------------
# Dipakai starter API pada Pertemuan 9. Buat nilai acak yang panjang.
APP_SECRET=__GANTI_APP_SECRET__

# --- Kunci latihan kriptografi ---------------------------------------
# Dipakai Pertemuan 5. Kunci dihasilkan program, bukan diketik manual,
# dan tidak pernah ditulis kembali ke dalam kode.
CRYPTO_KEY_PATH=./secrets/kunci_latihan.key

# --- Lokasi data -----------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_QUARANTINE_DIR=./data/karantina

# --- Log -------------------------------------------------------------
# Log tidak boleh memuat kata sandi, token, atau isi data pribadi.
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- Kunci starter API - Pertemuan 9 dan 11 --------------------------
# Setiap kunci mewakili satu identitas pemanggil. Pemetaan kunci ke
# identitas ada pada api/keamanan.py; yang rahasia hanya nilainya.
#
# Membuat nilai acak:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_MAHASISWA=__GANTI_API_KEY_MAHASISWA__
API_KEY_DOSEN_WALI=__GANTI_API_KEY_DOSEN_WALI__
API_KEY_ANALIS=__GANTI_API_KEY_ANALIS__

# --- Batas perilaku starter API --------------------------------------
# Keduanya punya nilai bawaan di kode; isi di sini hanya bila berbeda.
API_BATAS_BARIS_MAKS=50
API_AMBANG_SEL_KECIL=5
